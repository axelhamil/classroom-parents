{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/api": {
      "entry": [
        "src/container.ts",
        "src/shared/middleware/*.ts",
        "src/modules/*/module.ts",
        "src/modules/*/routes.ts"
      ],
      "project": ["**/*.ts"],
      "ignoreDependencies": ["pino-pretty"]
    },
    "apps/app": {
      "entry": [
        "routes.ts",
        "src/router/*.tsx",
        "src/features/**/*.route.tsx",
        "src/shared/api/api-client.ts",
        "src/shared/api/mutations/*.ts",
        "src/shared/api/queries/*.ts",
        "src/shared/observability/noop.ts",
        "src/shared/observability/sentry.ts",
        "a11y/*.setup.ts",
        "a11y/*.spec.ts"
      ],
      "project": ["**/*.ts", "**/*.tsx"],
      // Installed by the front foundation (T11), the only front task allowed to add dependencies:
      // the event list virtualises its rows (T13) and the screen tests drive taps (T12 to T15).
      "ignoreDependencies": ["@tanstack/react-virtual", "@testing-library/user-event"]
    },
    "packages/ddd-kit": {
      "project": ["src/**/*.ts"]
    },
    "packages/drizzle": {
      "project": ["src/**/*.ts"]
    },
    "packages/i18n": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/**/*.tsx", "src/**/*.ts"],
      "project": ["src/**/*.ts", "src/**/*.tsx"]
    },
    "packages/web-kit": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/test": {
      "project": ["src/**/*.ts"]
    },
    "packages/outbox": {
      "project": ["src/**/*.ts"]
    },
    "packages/email": {
      "project": ["src/**/*.ts"]
    },
    "packages/http": {
      "project": ["src/**/*.ts"]
    },
    "modules/*": {
      "entry": [
        "src/*.module.ts",
        "src/infrastructure/http/*.routes.ts",
        "scripts/check-*.ts",
        "eval/*.ts"
      ],
      "project": ["**/*.ts"]
    }
  },
  "ignoreBinaries": ["src/index.ts"],
  "ignoreDependencies": [
    // The root links every module so any workspace resolves @modules/<name>/schemas/*; the root itself imports none.
    "@modules/*",
    "@packages/typescript-config",
    "lint-staged",
    "tailwindcss"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "unlisted": "off",
    "unresolved": "off",
    "optionalPeerDependencies": "off",
    "exports": "warn",
    "types": "warn",
    "duplicates": "off"
  }
}
