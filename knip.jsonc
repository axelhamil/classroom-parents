{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/api": {
      "entry": [
        "src/container.ts",
        "src/shared/middleware/*.ts",
        "src/modules/*/module.ts",
        "src/modules/*/routes.ts"
      ],
      "project": ["**/*.ts"],
      "ignore": [
        // T10 binds the daily rgpd sweep worker on the sweep lock, purge, count and run store.
        "src/shared/internal-routes/sweep-count.ts",
        "src/shared/services/drizzle-sweep-run.store.ts",
        // Kept by the T1 brief: key derived from the versioned BETTER_AUTH_SECRETS, no consumer yet.
        "src/shared/auth/auth-secrets.ts"
      ],
      "ignoreDependencies": ["pino-pretty"]
    },
    "apps/app": {
      "entry": [
        "routes.ts",
        "src/router/*.tsx",
        "src/features/**/*.route.tsx",
        "src/shared/api/api-client.ts",
        "src/shared/api/mutations/*.ts",
        "src/shared/api/queries/*.ts",
        "src/shared/observability/noop.ts",
        "src/shared/observability/sentry.ts",
        "a11y/*.setup.ts",
        "a11y/*.spec.ts"
      ],
      "project": ["**/*.ts", "**/*.tsx"]
    },
    "packages/ddd-kit": {
      "project": ["src/**/*.ts"]
    },
    "packages/drizzle": {
      "project": ["src/**/*.ts"]
    },
    "packages/i18n": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/**/*.tsx", "src/**/*.ts"],
      "project": ["src/**/*.ts", "src/**/*.tsx"]
    },
    "packages/web-kit": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/test": {
      "project": ["src/**/*.ts"]
    },
    "packages/outbox": {
      "project": ["src/**/*.ts"]
    },
    "packages/email": {
      "project": ["src/**/*.ts"]
    },
    "packages/http": {
      "project": ["src/**/*.ts"]
    },
    "modules/*": {
      "entry": [
        "src/*.module.ts",
        "src/infrastructure/http/*.routes.ts",
        "scripts/check-*.ts",
        "eval/*.ts"
      ],
      "project": ["**/*.ts"],
      // Pre-installed by T3 so module tasks never touch the lockfile. Drop a name once every module declaring it imports it:
      // knip then prints "Remove from ignoreDependencies". Owner: T10 (raccord), see the T3 report.
      "ignoreDependencies": [
        "@anthropic-ai/sdk",
        "@packages/drizzle",
        "@packages/email",
        "@packages/events",
        "@packages/http",
        "@packages/outbox",
        "@types/web-push",
        "drizzle-orm",
        "hono",
        "web-push",
        "zod"
      ]
    }
  },
  "ignoreBinaries": ["src/index.ts"],
  "ignoreDependencies": [
    // The root links every module so any workspace resolves @modules/<name>/schemas/*; the root itself imports none.
    "@modules/*",
    "@packages/test",
    "@packages/typescript-config",
    "lint-staged",
    "tailwindcss"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "unlisted": "off",
    "unresolved": "off",
    "optionalPeerDependencies": "off",
    "exports": "warn",
    "types": "warn",
    "duplicates": "off"
  }
}
