{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build src/index.ts src/migrate.ts --outdir dist --target bun --minify --splitting",
    "migrate": "bun src/migrate.ts",
    "db:seed": "bun scripts/seed-dev-session.ts",
    "db:seed:demo": "FAKE_PROVIDERS=1 bun scripts/seed-demo.ts",
    "check:wipe-rollback": "bun scripts/check-wipe-rollback.ts",
    "check:uow-rollback": "bun scripts/check-uow-rollback.ts",
    "check:outbox-lease": "bun scripts/check-outbox-lease.ts",
    "check:token-sealing": "bun scripts/check-token-sealing.ts",
    "check:child-sign-in": "bun scripts/check-child-sign-in.ts",
    "check:alert-context": "bun scripts/check-alert-context.ts",
    "check:calendar-feed": "bun scripts/check-calendar-feed.ts",
    "check:email-retention": "bun scripts/check-email-retention.ts",
    "check:event-retention": "FAKE_PROVIDERS=1 bun scripts/check-event-retention.ts",
    "check:end-to-end": "FAKE_PROVIDERS=1 bun scripts/check-end-to-end.ts",
    "check:weekly-digest": "FAKE_PROVIDERS=1 bun scripts/check-weekly-digest.ts",
    "serve:journey": "FAKE_PROVIDERS=1 bun scripts/serve-journey.ts",
    "check:db": "pnpm run check:uow-rollback && pnpm run check:outbox-lease && pnpm run check:wipe-rollback && pnpm run check:token-sealing && pnpm run check:child-sign-in && pnpm run check:alert-context && pnpm run check:calendar-feed && pnpm run check:email-retention && pnpm run check:event-retention && pnpm run check:end-to-end && pnpm run check:weekly-digest",
    "start": "bun dist/migrate.js && bun dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "bun test --isolate --parallel --pass-with-no-tests",
    "test:watch": "bun test --isolate --watch --pass-with-no-tests",
    "test:coverage": "bun test --isolate --parallel --coverage --pass-with-no-tests"
  },
  "dependencies": {
    "@modules/agenda": "workspace:*",
    "@modules/alerts": "workspace:*",
    "@modules/calendar-feed": "workspace:*",
    "@modules/children": "workspace:*",
    "@modules/classroom-sync": "workspace:*",
    "@modules/extraction": "workspace:*",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@packages/ddd-kit": "workspace:*",
    "@packages/drizzle": "workspace:*",
    "@packages/email": "workspace:*",
    "@packages/emails": "workspace:*",
    "@packages/events": "workspace:*",
    "@packages/http": "workspace:*",
    "@packages/i18n": "workspace:*",
    "@packages/outbox": "workspace:*",
    "@packages/sentry-scrub": "workspace:*",
    "@sentry/bun": "^11.9.0",
    "better-auth": "1.7.14",
    "hono": "^4.13.14",
    "hono-pino": "^0.10.3",
    "inwire": "^4.0.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "rate-limiter-flexible": "^11.2.3",
    "resend": "^6.35.0",
    "tldts": "^7.4.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@packages/test": "workspace:*",
    "@packages/typescript-config": "workspace:*",
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2"
  }
}
