NODE_ENV=development
PORT=3000
# Socket idle timeout for Bun.serve, in seconds. Bun's own default is 10s and it
# applies while the handler runs, so leaving it unset silently kills any long
# response, including an SSE stream. Max 255.
SERVER_IDLE_TIMEOUT_SECONDS=120
# Wall-clock budget of one pending-deletion sweep: it stops between accounts once
# it is spent and answers truncated: true; the next run resumes.
SWEEP_DEADLINE_MS=90000

# REQUIRED IN PROD. Local: written by scripts/worktree-db.sh, one database per worktree.
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/classroom_parents

# REQUIRED IN PROD, comma-separated origins (e.g. https://app.example.com). The api fails hard at
# boot if unset in production (no silent localhost fallback). Feeds cors() and the CSRF Origin
# allowlist only: BetterAuth trusts APP_ORIGIN alone, so a second front listed here is refused
# by every auth action.
# 5173 is the dev server, 4173 the preview build the accessibility gate audits.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# REQUIRED IN PROD, public api URL (e.g. https://api.example.com)
BETTER_AUTH_URL=http://localhost:3000

# REQUIRED IN PROD, generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

# Optional, secret rotation: comma-separated "<version>:<secret>" pairs, current first
# (e.g. 2:<new>,1:<old>). BETTER_AUTH_SECRET then only decrypts data from before the first rotation.
# BETTER_AUTH_SECRETS=

# REQUIRED IN PROD, origin of the front (e.g. https://app.example.com): email links and the
# only origin BetterAuth trusts (trustedOrigins, callback and redirect URLs). It must share its
# registrable domain with BETTER_AUTH_URL, the boot refuses otherwise (SameSite=Lax cookies).
APP_ORIGIN=http://localhost:5173

# REQUIRED, OAuth web client of the Google Cloud project (redirect URIs <api>/api/auth/callback/google
# for the parent sign-in and <api>/api/auth/callback/google-classroom for linking a child).
# The local values below are dummies: sign-in needs a real client, the tests and checks do not.
GOOGLE_CLIENT_ID=local-dummy-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=local-dummy-client-secret

# REQUIRED IN PROD, parent domain for the session cookie (e.g. example.com). The cookie is SameSite=Lax,
# so app and api must be on the same site: subdomains of one registrable domain set here, or
# one host with this left empty. Two sites, or two subdomains of a public suffix (platform
# domains), drop the cookie on every fetch and sign everyone out. A value that is not a parent
# of both hosts fails the boot.
COOKIE_DOMAIN=

# Resend, REQUIRED IN PROD (live key + verified domain SPF+DKIM+DMARC, EU region). Sends the
# alert email when a parent has no live push subscription.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# REQUIRED IN PROD, announcement extraction. Empty locally: run with FAKE_PROVIDERS=1.
ANTHROPIC_API_KEY=

# REQUIRED IN PROD, Web Push signing keys, generate once: bunx web-push generate-vapid-keys
# (public = 87 base64url characters, private = 43). VAPID_SUBJECT is mailto: or https://.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@example.com

# Local only: scripted Classroom, deterministic extractor, push and email sinks. Refused at boot
# in production.
FAKE_PROVIDERS=0

# RGPD
RGPD_GRACE_PERIOD_DAYS=7
RGPD_SWEEP_BATCH_SIZE=50

# Outbox relay. A claimed event is leased for OUTBOX_LEASE_SECONDS (>= the handler budget + 10 s),
# each handler is cut after OUTBOX_HANDLER_BUDGET_SECONDS, OUTBOX_CONCURRENCY events settle
# in parallel; after OUTBOX_MAX_ATTEMPTS failures the event is dead and retried every
# OUTBOX_DEAD_RETRY_HOURS.
OUTBOX_LEASE_SECONDS=120
OUTBOX_HANDLER_BUDGET_SECONDS=30
OUTBOX_CONCURRENCY=4
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_DEAD_RETRY_HOURS=6
# Email delivery worker. A claimed message is leased for EMAIL_LEASE_SECONDS (>= the 30 s send
# timeout + a 15 s margin, enforced at boot); on its 4th retryable failure it is dead and retried
# every EMAIL_DEAD_RETRY_HOURS, but only while it is younger than EMAIL_DEAD_REPLAY_WINDOW_HOURS
# (> EMAIL_DEAD_RETRY_HOURS and <= 24, the lifetime of a Resend idempotency key).
EMAIL_LEASE_SECONDS=120
EMAIL_DEAD_RETRY_HOURS=6
EMAIL_DEAD_REPLAY_WINDOW_HOURS=24

# Health probes: GIT_SHA is written at every deploy.
GIT_SHA=
BUILD_TIME=
# Grace window after SIGTERM: /readyz flips to 503 instantly, in-flight requests drain for N ms before workers stop.
SHUTDOWN_GRACE_PERIOD_MS=15000
# The http and database pool steps after the grace are cut after N ms.
SHUTDOWN_STEP_TIMEOUT_MS=2000
# The workers step (email, outbox, stream hub) is cut after N ms; the pool step is then skipped.
SHUTDOWN_WORKERS_TIMEOUT_MS=12000
# Hard cap of the whole shutdown (exit 1). Must cover grace + 1000 + 2 x step + workers + 2500 + 1000, and stay under the platform SIGKILL delay.
SHUTDOWN_DEADLINE_MS=36000

# Sentry, REQUIRED IN PROD (EU residency: use *.eu.sentry.io DSN). Empty DSN = NoOp.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0

# Rate-limit store backend.
# "memory": in-process counter (resets on restart, not shared across replicas).
# "postgres": durable Postgres store, shared across replicas (requires the rate_limit table via db:push).
#   On a store error, auth-sensitive policies fail CLOSED (503); general traffic fails open.
RATE_LIMIT_STORE=postgres

# Captcha: above 80 % of the sign-in and sign-up windows, a request needs a valid token in the
# X-Captcha-Token header, or gets CAPTCHA_REQUIRED. A provider outage fails open.
# CAPTCHA_SECRET_KEY=
# CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# CAPTCHA_TIMEOUT_MS=3000

# REQUIRED IN PROD behind a load-balancer or reverse proxy. Comma-separated entries: the keyword
# `private` (trusts all private ranges), CIDR ranges (10.0.0.0/8, fd00::/8), or exact IPs. When
# unset behind a proxy, all users share the proxy IP as rate-limit key (the api warns at boot).
TRUSTED_PROXIES=
