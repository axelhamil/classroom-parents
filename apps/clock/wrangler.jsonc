{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clock",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-14",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/15 * * * *"] },
  "secrets": { "required": ["API_URL", "CRON_SECRET"] },
  "observability": { "enabled": true },
  "send_metrics": false
}
