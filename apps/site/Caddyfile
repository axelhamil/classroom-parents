{
    auto_https off
    admin off
    persist_config off
    servers {
        trusted_proxies static private_ranges
    }
}

:{$PORT:80} {
    root * /srv
    encode zstd gzip

    # The page CSP is the <meta> Astro writes with the hash of every inline script and
    # style; the header only adds what a <meta> cannot carry.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "frame-ancestors 'none'; object-src 'none'"
        -Server
    }

    @revalidated not path /_astro/*
    header @revalidated Cache-Control "no-cache"

    handle /health {
        respond "OK" 200
    }

    handle /_astro/* {
        @present file
        header @present Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    handle {
        try_files {path} {path}.html {path}/index.html
        file_server
    }

    handle_errors 404 {
        rewrite * /404.html
        file_server
    }
}
