# Public origin of this site (root domain): canonical, Open Graph, sitemap and robots.txt.
PUBLIC_SITE_URL=http://localhost:4181

# Origin of the app (apps/app): the sign in button and the legal links point there.
PUBLIC_APP_URL=http://localhost:4177

# OAuth client id of the app (same value as the api's GOOGLE_CLIENT_ID), printed on the guide for school administrators.
PUBLIC_GOOGLE_CLIENT_ID=local-dummy-client-id.apps.googleusercontent.com

# Contact address shown on the guide for school administrators (same as the app's VITE_CONTACT_EMAIL).
PUBLIC_CONTACT_EMAIL=contact@example.com
