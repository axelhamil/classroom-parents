{
    auto_https off
    admin off
    persist_config off
    servers {
        trusted_proxies static private_ranges
    }
}

import /etc/caddy/static-site.caddy

:{$PORT:80} {
    import spa_site
    import security_headers

    header {
        Content-Security-Policy "default-src 'self'; script-src 'nonce-{http.request.uuid}' 'strict-dynamic' https: 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
    }
}
